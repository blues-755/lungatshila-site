# Local .terraform directories
**/.terraform/*

# Terraform state files — these can contain sensitive values in plaintext
# (even with a remote backend, local state can exist from before migration)

*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore any .tfvars files that might contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Lock file — commit this one actually (see note below), but ignoring here
# as a placeholder in case your workflow differs
# .terraform.lock.hcl

# macOS
.DS_Store
